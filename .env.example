INGEST_MODE=private          # private|plain -> token-only; tls -> Caddy+LetsEncrypt on $DOMAIN
INGEST_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN   # openssl rand -hex 32
DOMAIN=otel.example.com      # tls only
ACME_EMAIL=ops@example.com   # tls only
COLLECTOR_BIND=0.0.0.0       # private mode: set to the private NIC IP
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
VM_RETENTION=3               # VictoriaMetrics: months
VL_RETENTION=90d             # VictoriaLogs: duration
