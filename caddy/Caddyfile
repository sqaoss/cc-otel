{$DOMAIN} {
	tls {$ACME_EMAIL}

	# OTLP/gRPC over h2c (fragile; README steers public senders to http/protobuf instead)
	@grpc header Content-Type application/grpc*
	handle @grpc {
		reverse_proxy collector:4317 {
			transport http {
				versions h2c 2
			}
		}
	}

	# OTLP/HTTP (recommended public path): http/protobuf
	handle /v1/* {
		reverse_proxy collector:4318
	}
}
